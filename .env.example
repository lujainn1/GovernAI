# OpenRouter API configuration
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Any model slug available on OpenRouter (https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional, sent as attribution headers to OpenRouter
OPENROUTER_SITE_URL=https://github.com/lujainn1/governai
OPENROUTER_APP_NAME=GovernAI

# Optional: override where reports / audit log / policy data are stored
# GOVERNAI_DATA_DIR=./data
