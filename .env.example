# OpenAI API configuration
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Any OpenAI model, e.g. gpt-4o-mini, gpt-4o, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: override where the seed-data YAML files (policies/risk rules) live
# GOVERNAI_DATA_DIR=./data

# Supabase (authentication + database)
# Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key: keep this secret, backend-only, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
